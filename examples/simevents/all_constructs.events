# Covers the SIMEVENTS 1.2 constructs not used by simulator_events.events.
# Validate with: python3 -m rips.simulator_events all_constructs.events

SIMEVENTS 1.2
UNIT METRIC

DATE     START    = 2024-01-31
DATE     WORKOVER = 2024-05-15T14:45:30 + 1mon
DURATION RAMP     = 1d12h30m
DURATION SETTLE   = 1.5h
FILTER   OILY     = "DYNAMIC.SOIL >= 0.6 OR STATIC.PERMX > 250"

WELL P1 = "OP-1"

SCHEDULE
  START                 RPTRST     BASIC=2
  START                 INSERT_DATE  EVERY=1mon  UNTIL="START + 6mon"  COMMENT="Monthly report"
  START + 3mon          RAW_TEXT   PLACEMENT=BEFORE_KEYWORD  ANCHOR=WCONPROD  PRIORITY=-1
-- Inserted before WCONPROD on this date
END_RAW_TEXT
  2024-12-31            RESTART

GROUP "FIELD"
  START  MEMBER    MEMBERS="PLATFORM_A,PLATFORM_B"
  START  GCONPROD  CONTROL_MODE=ORAT  OIL_TARGET=5000

WELL P1
  START                     WELSPECS     GROUP=PLATFORM_A  PHASE=OIL  CROSSFLOW=False  REFDEPTH=2000
  START                     PERFORATION  MDSTART=2010  MDEND=2090  FILTER=OILY
  START                     SEGMENT      MDSTART=2000  MDEND=2100  INNER_DIAMETER=0.15  ROUGHNESS=1e-5  PRESSURE_COMPONENTS=HF-
  START + RAMP              VALVE        MD=2050  TYPE=ICV  STATE=OPEN  CV=0.7  AREA=0.0001
  START + RAMP + SETTLE     WCONPROD     STATUS=OPEN  CMODE=ORAT  ORAT=800
  WORKOVER - 2d             STATE        STATE=SHUT  COMMENT="Workover"
  WORKOVER + -1d12h         WELSPECS     REFDEPTH=2005.5
